{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build EasyX Red-Black Tree",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\build_easyx.ps1"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Run Reference Tree Tests",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\run_reference_tests.ps1"
            ],
            "group": "test",
            "problemMatcher": "$gcc"
        }
    ]
}
